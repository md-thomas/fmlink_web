# Copy this to station.env and fill in this station's own settings, then
# just run ./run.sh (no arguments) to start it, or restart the service -
# see run.sh for how this file is used. ./run.sh --help lists every option.
RUN_ARGS=(
    --station-id K0MDT-1
    --dst K0MDT-2
    --radio
    --tx-level 0.6
)
