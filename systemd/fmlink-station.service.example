# A systemd --user service for this station, so it starts on boot/login
# and restarts itself if it crashes, instead of needing a terminal left
# open running ./run.sh. See GettingStarted.md for how to install this.
#
# station.env (see station.env.example) must already be set up - this
# unit runs a bare ./run.sh, with no arguments of its own.

[Unit]
Description=FMlink station
After=network.target sound.target
# No burst limit: if the radio isn't plugged in yet (or drops out),
# connect_from_args() exits immediately every time, and systemd's default
# 5-tries-in-10s limit would otherwise mark this 'failed' for good rather
# than keep waiting for the hardware to show up.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%INSTALL_DIR%
ExecStart=%INSTALL_DIR%/run.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
